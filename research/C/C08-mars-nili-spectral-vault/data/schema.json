      "x-quality-rule": "Blind identity hidden during calibration."
    },
    "mass_fraction": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "x-dimension": "k",
      "description": "Weighed mineral mass fractions.",
      "x-unit": "1",
      "x-source-type": "float64[k]",
      "x-quality-rule": "Nonnegative and sum one within balance uncertainty."
    },
    "grain_distribution": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Particle-size bins and weights.",
      "x-unit": "micrometer",
      "x-source-type": "table",
      "x-quality-rule": "Missing tails and sieve convention documented."
    },
    "geometry": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Incidence, emergence and phase.",
      "x-unit": "degree",
      "x-source-type": "float64[3]",
      "x-quality-rule": "Record instrument frame and sample orientation."
    },
    "reflectance": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "x-dimension": "n",
      "description": "Standard-referenced spectrum.",
      "x-unit": "1",
      "x-source-type": "float64[n]",
      "x-quality-rule": "Bad wavelengths remain masked; retain nonphysical noisy values for diagnosis."
    },
    "reflectance_cov": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "x-dimension": "n"
      },
      "x-dimension": "n",
      "description": "Standard, repeat and detector covariance.",
      "x-unit": "1",
      "x-source-type": "float64[n,n]",
      "x-quality-rule": "Shared standard uncertainty retained."
    },
    "optical_fraction": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "representation"
      ],
      "properties": {
        "representation": {
          "enum": [
            "empirical",
            "parametric",
            "summary",
            "unidentified"
          ]
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
