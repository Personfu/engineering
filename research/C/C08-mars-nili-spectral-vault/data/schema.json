          }
        },
        "weights": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "parameters": {
          "type": "object"
        },
        "summary": {
          "type": "object"
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true,
