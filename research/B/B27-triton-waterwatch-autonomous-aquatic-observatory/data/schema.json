{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B27 TRITON WATERWATCH — Autonomous Aquatic Observatory engineering data contract",
  "description": "Proposed record contract. No data have been collected by this generator. Null is missing/unknown and must be qualified in the separate provenance record.",
  "type": "object",
  "properties": {
    "sensor_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Original and aligned reading times.",
      "x-unit": "UTC",
      "x-source-type": "datetime",
      "x-quality-rule": "Clock source/offset covariance required."
    },
    "position_xy": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "Projected vessel location.",
      "x-unit": "m",
      "x-source-type": "float[2]",
      "x-quality-rule": "CRS and GPS covariance saved."
    },
    "sensor_depth": {
      "type": [
        "number",
        "null"
      ],
      "description": "Measurement support below surface.",
      "x-unit": "m",
      "x-source-type": "nullable float",
      "x-quality-rule": "Null cannot imply full-column reading."
    },
    "temperature": {
      "type": [
        "number",
        "null"
      ],
      "description": "Calibrated water temperature.",
      "x-unit": "°C",
      "x-source-type": "nullable float",
      "x-quality-rule": "Reference check and drift flags retained."
    },
    "conductivity": {
      "type": [
        "number",
        "null"
      ],
      "description": "Specified reference-temperature channel.",
      "x-unit": "µS/cm",
      "x-source-type": "nullable float",
      "x-quality-rule": "Compensation method required."
    },
    "dissolved_oxygen": {
      "type": [
        "number",
        "null"
      ],
      "description": "Compensated oxygen measurement.",
      "x-unit": "mg/L",
      "x-source-type": "nullable float",
      "x-quality-rule": "Pressure/salinity metadata retained."
    },
    "response_model": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "x-encoding": "Structured JSON record; member names, frames and mandatory subfields must be frozen in the project ICD before ingestion.",
      "description": "Dead-time/first-order response description.",
      "x-unit": "s",
      "x-source-type": "record",
      "x-quality-rule": "Correction support and noise amplification saved."
    },
    "map_covariance": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "x-dimension": "row/column ordering and dimensions frozen in ICD",
      "description": "Joint spatial/temporal prediction uncertainty.",
      "x-unit": "parameter-unit²",
      "x-source-type": "matrix",
      "x-quality-rule": "Calibration and position covariance included."
    }
  },
  "required": [
    "sensor_time",
    "position_xy",
    "sensor_depth",
    "temperature",
    "conductivity",
    "dissolved_oxygen",
    "response_model",
    "map_covariance"
  ],
  "additionalProperties": false,
  "x-project-id": "B27",
  "x-unit-policy": "Use documented units; do not replace missing values with zero. Reference frames, covariance basis, calibration version and quality qualifiers reside in the provenance sidecar.",
  "x-domain-validation": "Physical range, covariance validity and declared quality rules require domain validation beyond JSON Schema."
}
