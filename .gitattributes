* text=auto eol=lf

# Preserve the exact bytes covered by the scientific data/figure manifests.
models/data/** -text
archive/astra_forge/data/synthetic/** -text
models/figures/** -text
# Matplotlib writes insignificant spaces in SVG path geometry.
models/figures/*.svg whitespace=-trailing-space
# Windows-generated data records preserve CRLF as part of their saved hashes.
models/data/** whitespace=cr-at-eol
# Preserve independently hashed presentation figures and their Matplotlib path whitespace.
data/figures/*.svg -text whitespace=-trailing-space
data/figures/*.png -text
