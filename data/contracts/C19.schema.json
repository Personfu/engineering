      "x-unit": "micrometer",
      "x-source-type": "float64[n]",
      "x-quality-rule": "Air/vacuum and rest/observer frame declared."
    },
    "flux": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "x-dimension": "n",
      "description": "Spectral measurements.",
      "x-unit": "documented physical or normalized",
      "x-source-type": "float64[n]",
      "x-quality-rule": "Normalization type explicit; bad/telluric pixels masked."
    },
    "flux_cov": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
